 },
 {
  "doctype": "Custom Field",
  "dt": "Job Applicant",
  "fieldname": "ats_reason",
  "fieldtype": "Small Text",
  "label": "ATS Reason",
  "read_only": 1,
  "insert_after": "ats_result"
 },
 {
  "doctype": "Custom Field",
  "dt": "Job Applicant",
  "fieldname": "ats_screened_on",
  "fieldtype": "Datetime",
  "label": "ATS Screened On",
  "read_only": 1,
  "insert_after": "ats_reason"
 },
 {
  "doctype": "Custom Field",
  "dt": "Job Applicant",
  "fieldname": "ats_breakdown_html",
