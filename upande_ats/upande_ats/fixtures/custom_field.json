[
 {
  "doctype": "Custom Field",
  "dt": "Job Opening",
  "fieldname": "ats_section",
  "fieldtype": "Section Break",
  "label": "ATS Configuration",
  "insert_after": "description",
  "collapsible": 1
 },
 {
  "doctype": "Custom Field",
  "dt": "Job Opening",
  "fieldname": "ats_keywords",
  "fieldtype": "Table",
  "label": "ATS Keywords",
  "options": "ATS Keyword",
  "insert_after": "ats_section"
 },
 {
  "doctype": "Custom Field",
  "dt": "Job Opening",
  "fieldname": "ats_passmark_override",
  "fieldtype": "Percent",
  "label": "Passmark Override %",
  "description": "Overrides the default passmark from ATS Settings for this opening only.",
  "insert_after": "ats_keywords"
 },
 {
  "doctype": "Custom Field",
  "dt": "Job Applicant",
  "fieldname": "ats_section",
  "fieldtype": "Section Break",
  "label": "ATS",
