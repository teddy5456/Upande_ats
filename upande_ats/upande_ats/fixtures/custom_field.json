  "in_list_view": 1,
  "in_standard_filter": 1,
  "insert_after": "ats_section"
 },
 {
  "doctype": "Custom Field",
  "dt": "Job Applicant",
  "fieldname": "ats_passes_passmark",
  "fieldtype": "Check",
